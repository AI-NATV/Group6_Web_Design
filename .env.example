# Comma-separated browser origins. Use the deployed HTTPS frontend origin in production.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 10 MiB unless explicitly adjusted for your deployment.
MAX_FILE_SIZE_BYTES=10485760
# Database. Default: SQLite file in the git-ignored data/ folder.
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL example (install psycopg[binary] first):
# DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/revenue_analytics
# Signs login tokens. Required: the server refuses to start without it. Generate one per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value.
SECRET_KEY=replace-with-a-generated-value
# Minutes before a login token expires (users then sign in again).
ACCESS_TOKEN_EXPIRE_MINUTES=30
